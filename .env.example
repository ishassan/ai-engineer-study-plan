# Copy this file to .env and fill in the key. Git ignores .env.

# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Postgres on your machine. Change the port if 5432 is in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant

# Response cache of week 1: "on" replays saved responses, "off" always calls the API.
RESPONSE_CACHE=on

# Phase 2. The embedding service and the re-ranking service run in Docker.
# On an Intel or AMD machine, remove the "#" of the next line. The default image is for Apple Silicon.
# TEI_TAG=cpu-1.9.4
# Change a port if it is in use, and change the same port in the URL.
EMBEDDINGS_PORT=8081
RERANKER_PORT=8082
EMBEDDINGS_URL=http://localhost:8081
RERANKER_URL=http://localhost:8082

# Phase 3. Langfuse runs in Docker. At each start it creates a project with these keys if
# they do not exist. These keys work only on your machine.
LANGFUSE_PUBLIC_KEY=pk-lf-local-lab
LANGFUSE_SECRET_KEY=sk-lf-local-lab
# Change the port if 3000 is in use, and change the same port in the URL.
LANGFUSE_PORT=3000
LANGFUSE_BASE_URL=http://localhost:3000

# Phase 4. The OpenAI API key, for the graph on OpenAI in week 14 (PROVIDER=openai).
OPENAI_API_KEY=
# The loop that answers: handwritten (assistant/agent.py) or langgraph (assistant/graph.py).
AGENT_IMPL=handwritten
# The provider of the model of the graph: anthropic or openai.
PROVIDER=anthropic
# Phase 4, week 16. The two MCP servers (`make up` starts them) and the limits of the SQL server.
MCP_SQL_URL=http://localhost:8091/mcp
MCP_CATALOGUE_URL=http://localhost:8092/mcp
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SECONDS=5
