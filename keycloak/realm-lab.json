{
  "realm": "lab",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "groups": [
    {
      "name": "analysts"
    },
    {
      "name": "auditors"
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "The subject of the token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "The user name of the user.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp:tools",
      "description": "Use the tools of the assistant: the API and the two MCP servers.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience assistant-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "assistant-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience mcp-sql",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-sql",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience mcp-catalogue",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-catalogue",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "profile",
    "mcp:tools"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "assistant-cli",
      "name": "Lab scripts and MCP clients",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "mcp:tools"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "assistant-service",
      "name": "Evaluation jobs",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "assistant-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "mcp:tools"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@lab.example",
      "firstName": "Viewer",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "viewer-password",
          "temporary": false
        }
      ],
      "groups": []
    },
    {
      "username": "analyst",
      "enabled": true,
      "emailVerified": true,
      "email": "analyst@lab.example",
      "firstName": "Analyst",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "analyst-password",
          "temporary": false
        }
      ],
      "groups": [
        "/analysts"
      ]
    },
    {
      "username": "auditor",
      "enabled": true,
      "emailVerified": true,
      "email": "auditor@lab.example",
      "firstName": "Auditor",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "auditor-password",
          "temporary": false
        }
      ],
      "groups": [
        "/auditors"
      ]
    },
    {
      "username": "service-account-assistant-service",
      "enabled": true,
      "serviceAccountClientId": "assistant-service",
      "groups": [
        "/analysts",
        "/auditors"
      ]
    }
  ]
}
